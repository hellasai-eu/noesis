# Frontend environment variables
# Copy this file to .env and fill in your values.
#
#
# VITE_SUPABASE_URL — Supabase Dashboard → Settings → API (use http://127.0.0.1:54321 for local dev)
# VITE_SUPABASE_PUBLISHABLE_KEY — Supabase Dashboard → Settings → API (anon/public key).
#   For local development, run `supabase status` and copy the ANON_KEY it prints.
#   Nothing fills this in for you: copy this template to .env and replace the
#   placeholder there. Vite reads .env, not this file — editing the template in
#   place changes nothing, and every Supabase request will still fail.

VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="paste-the-anon-key-from-supabase-status"

# Optional — error reporting. A no-op when unset.
# VITE_SENTRY_DSN=""

# Optional — the deployment overlay: the product name, the logo, the landing page
# at / and the legal documents at /legal/*. Defaults to ./deployment, which holds
# this repository's neutral placeholders. A deployment copies its own directory
# into the checkout and names it here; see deployment/README.md for the contract
# and for why the path has to be inside the checkout.
#
# This is a build-time variable read by vite.config.ts, not a VITE_* value
# exposed to the bundle — so it belongs in the build environment, and `npm run
# dev`, `npm run build` and `vitest` all honour it.
# DEPLOYMENT_DIR="./my-deployment"
