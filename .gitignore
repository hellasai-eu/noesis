# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files
.env
.env.*
!.env.example
supabase/.env*

# Local Supabase CLI scratch state (per-machine, never shared)
supabase/.branches/
supabase/.temp/

# Every supabase/.env* stays ignored, with no exception. An encrypted
# `.env.preview` used to be committed here so Supabase Branching could decrypt
# it at branch-deploy time, but that ties this repository to one deployment's
# keys and keypair. Deployment-specific values belong in whatever private
# repository does the hosting; `supabase/config.toml` still declares which
# variables edge functions expect, which is generic.

# Deploy secrets
.env.deploy

# A deployment's own overlay, copied into the checkout at build time and
# pointed at with DEPLOYMENT_DIR (see deployment/README.md). The name, logo,
# landing page, legal text and security policy belong to whichever private
# repository does the hosting; `deployment/` holds this repository's neutral
# defaults and stays committed.
/my-deployment/
/overlay/

# Backup/temp files
*~

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.dianoisis/

# Playwright
.auth/

# Fly.io
fly.toml
.dockerignore

# Python bytecode (scripts/ has a few CI helpers)
__pycache__/
*.pyc

# `tsc -b` (npm run typecheck) writes incremental build state next to each
# referenced tsconfig. Nothing consumes it outside the local run.
*.tsbuildinfo

# gstack browse/skill session artifacts (machine-local)
.gstack/
