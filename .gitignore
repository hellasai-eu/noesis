# Python bytecode (scripts/ has a few CI helpers)
__pycache__/
*.pyc

# `tsc -b` (npm run typecheck) writes incremental build state next to each
# referenced tsconfig. Nothing consumes it outside the local run.
*.tsbuildinfo

# gstack browse/skill session artifacts (machine-local)
.gstack/
