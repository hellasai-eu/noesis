  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "./start_local.sh",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "check:dialog-scroll": "./scripts/check-dialog-scroll.sh",
    "settings:sql": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/emit-settings-sql.ts",
    "brand:env": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/emit-brand-env.ts",
    "preview": "vite preview",
    "test": "deno test --allow-net --allow-env --allow-read supabase/functions/_shared/__tests__/",
    "test:watch": "deno test --watch --allow-net --allow-env --allow-read supabase/functions/_shared/__tests__/",
    "test:coverage": "deno test --coverage=coverage --allow-net --allow-env --allow-read supabase/functions/_shared/__tests__/",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "test:frontend:coverage": "vitest run --coverage",
    "test:rls": "vitest run --config supabase/tests/rls/vitest.config.rls.ts",
    "test:all": "npm run test:frontend && npm run test && npm run test:rls",
    "test:coverage:all": "npm run test:frontend:coverage && npm run test:coverage",
    "gen:types": "supabase gen types typescript --linked > src/integrations/supabase/types.ts"
  },
